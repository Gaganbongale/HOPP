{
  "name": "hubli-dharwad-transit-planner",
  "version": "1.0.0",
  "description": "Public Transport Planner MVP backend for Hubli-Dharwad",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:generate": "node seeds/generateSeedFiles.js",
    "seed:transit": "node seeds/seedDatabase.js --transit-only",
    "seed": "node src/scripts/seedAll.js",
    "seed:reset": "node src/scripts/seedAll.js --reset",
    "validate-network": "node src/scripts/validateNetwork.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "winston": "^3.13.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
