# Set this to a DNS name pointed at the public server running Docker Compose.
SITE_DOMAIN=
CORS_ORIGIN=

MONGO_ROOT_USERNAME=hop_admin
# Use a long URL-safe value, for example: openssl rand -hex 32
MONGO_ROOT_PASSWORD=
# docker-compose constructs the authenticated MongoDB URI for the private service.

# Generate a separate random secret, e.g. openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h
NODE_ENV=production
PORT=5000

# Optional integrations. Keep secret values only in this server-side .env file.
GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
TICKET_BASE_FARE_RUPEES=10
TICKET_FARE_PER_KM_RUPEES=2
